# Tidak ada database dan cache. Setiap pencarian mengambil data langsung.

# Timeout per toko dalam milidetik.
STORE_TIMEOUT_MS=6500

# true: gunakan data fallback lokal ketika toko gagal/menolak request.
# false: hanya tampilkan data live yang berhasil diambil.
ALLOW_DEMO_FALLBACK=true

# true: aktifkan adapter halaman publik (best effort).
ENABLE_PUBLIC_PAGE_ADAPTERS=true

# Opsional: OpenAI hanya digunakan untuk memahami query game yang tidak dikenali.
# Tanpa key, pencarian tetap bekerja memakai alias lokal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Opsional: feed JSON partner/affiliate tambahan.
# Format: array JSON. URL boleh mengandung {gameSlug}.
# Respons yang didukung:
# 1) Array langsung: [{"name":"85 Diamonds","price":23000,"url":"..."}]
# 2) Object: {"products":[...]}
# PROVIDER_FEEDS_JSON=[{"id":"partner-a","name":"Partner A","url":"https://example.com/products/{gameSlug}.json","purchaseBaseUrl":"https://example.com"}]
PROVIDER_FEEDS_JSON=[]
